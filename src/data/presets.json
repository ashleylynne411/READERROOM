{
  "presetId": "gothic-manor-rain",
  "displayName": "Gothic Manor During a Rainstorm",
  "genreTags": ["gothic", "dark romance", "horror", "mystery"],
  "visuals": {
    "backgroundImage": "/assets/environments/gothic_manor.webp",
    "lightingOverlay": "rgba(10, 15, 30, 0.6)",
    "effects": ["window_rain", "candle_flicker", "fireplace_glow"]
  },
  "audioLayers": [
    {
      "id": "heavy_rain",
      "label": "Window Rain",
      "src": "/audio/rain_window_loop.mp3",
      "defaultVolume": 0.75,
      "pan": -0.2
    },
    {
      "id": "thunder_distant",
      "label": "Distant Thunder",
      "src": "/audio/thunder_loop.mp3",
      "defaultVolume": 0.3,
      "pan": 0.4
    },
    {
      "id": "fireplace",
      "label": "Fireplace Crackle",
      "src": "/audio/fireplace_loop.mp3",
      "defaultVolume": 0.45,
      "pan": 0.0
    },
    {
      "id": "ticking_clock",
      "label": "Grandfather Clock",
      "src": "/audio/clock_loop.mp3",
      "defaultVolume": 0.1,
      "pan": -0.8
    }
  ]
}